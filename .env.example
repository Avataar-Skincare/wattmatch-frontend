# Leave unset to run the frontend fully standalone (forms show a success state locally).
# Set to a running server URL (see ../server) to actually persist leads/contact messages.
VITE_API_URL=http://localhost:4000

# Razorpay checkout key id — public identifier only, safe to expose client-side. Use the test-mode
# key (rzp_test_...) here until go-live; going live is a key swap on both frontend and backend, no
# rebuild/code change needed.
VITE_RAZORPAY_KEY_ID=

# Stakeholder-demo aid — leave unset (or "false") everywhere except a demo build/checkout. When
# "true", the generator bid submission form shows a "Fill demo data" button that populates the form
# with valid dummy values and uploads placeholder PDFs for required documents. Never enables a
# backend bypass — every value it produces still goes through the real validation and endpoints, so
# it's safe to leave off in production simply by never setting it.
VITE_DEV_MODE=false
