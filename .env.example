# Leave unset to run the frontend fully standalone (forms show a success state locally).
# Set to a running server URL (see ../server) to actually persist leads/contact messages.
VITE_API_URL=http://localhost:4000

# Razorpay checkout key id — public identifier only, safe to expose client-side. Use the test-mode
# key (rzp_test_...) here until go-live; going live is a key swap on both frontend and backend, no
# rebuild/code change needed.
VITE_RAZORPAY_KEY_ID=
